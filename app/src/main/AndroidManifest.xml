<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.findly">

    <!-- ===== PERMISSIONS ===== -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="Findly"
        android:icon="@drawable/logo3"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- MAPS META-DATA (WAJIB jika pakai Google Maps SDK) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <!-- ===== ACTIVITIES ===== -->

        <!-- List tempat berdasarkan kategori -->
        <activity
            android:name=".PlaceListActivity"
            android:exported="false" />

        <!-- Detail Tempat -->
        <activity
            android:name=".PlaceDetailActivity"
            android:exported="false" />

        <!-- Tambah Tempat -->
        <activity
            android:name=".AddPlaceActivity"
            android:exported="false" />
        <activity android:name=".MapActivity" />
        <activity
            android:name=".FavoriteActivity"
            android:exported="false" />

        <!-- Home sebagai halaman utama -->
        <!-- Splash screen jadi launcher -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- HomeActivity tanpa intent-filter -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:label="@string/app_name" />


    </application>

</manifest>
