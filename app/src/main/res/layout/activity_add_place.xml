<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:fillViewport="true" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:padding="12dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="6dp"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp">
            <TextView  android:text="Tambah Tempat"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:background="@drawable/topbar"
                android:layout_marginBottom="8dp"
                android:layout_gravity="center"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="50dp"/>
        </LinearLayout>
        <EditText android:id="@+id/edtName" android:hint="Nama Tempat" android:layout_width="match_parent" android:layout_height="48dp"/>
        <EditText android:id="@+id/edtCategory" android:hint="Kategori" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"/>
        <EditText android:id="@+id/edtAddress" android:hint="Alamat" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"/>
        <EditText android:id="@+id/edtLat" android:hint="Latitude" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"/>
        <EditText android:id="@+id/edtLon" android:hint="Longitude" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"/>
        <EditText android:id="@+id/edtOpen" android:hint="Jam buka (08:00)" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"/>
        <EditText android:id="@+id/edtClose" android:hint="Jam tutup (21:00)" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"/>
        <EditText android:id="@+id/edtRating" android:hint="Rating (contoh: 4.5)" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"/>
        <EditText android:id="@+id/edtPrice" android:hint="Harga mulai (angka)" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnSave" android:text="Simpan" android:background="@drawable/button" android:textColor="@color/text" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="48dp"/>
    </LinearLayout>
</ScrollView>
